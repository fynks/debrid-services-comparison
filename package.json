{
  "name": "debrid-services-comparison",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Compare leading debrid / multi-hoster services for pricing, host coverage, policies & tools.",
  "scripts": {
    "dev": "vite",
    "optimize-json": "tsx scripts/optimize-json.ts",
    "pretypecheck": "npm run optimize-json",
    "typecheck": "tsc --noEmit",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "test": "npm run typecheck && npm run smoke-test",
    "verify": "npm run build && npm test",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
