{
  "name": "debrid-services-comparison",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Compare leading debrid / multi-hoster services for pricing, host coverage, policies & tools.",
  "scripts": {
    "dev": "vite",
    "optimize-json": "tsx scripts/optimize-json.ts",
    "sync-fonts": "tsx scripts/sync-fonts.ts",
    "pretypecheck": "bun run optimize-json",
    "typecheck": "tsc --noEmit",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "test": "bun run typecheck && bun run smoke-test",
    "verify": "bun run build && bun run test",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
