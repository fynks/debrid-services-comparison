{
  "name": "debrid-services-comparison",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Compare leading debrid / multi-hoster services for pricing, host coverage, policies & tools.",
  "scripts": {
    "dev": "vite",
    "optimize-json": "bash scripts/json-optimizer.sh data/file-hosts.json src/json/file-hosts-optimized.json && bash scripts/json-optimizer.sh data/adult-hosts.json src/json/adult-hosts-optimized.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "smoke-test:runtime": "tsx scripts/runtime-smoke.ts",
    "test": "npm run typecheck && npm run lint && npm run smoke-test",
    "build": "npm run optimize-json && vite build && workbox generateSW workbox-config.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "prebuild": "npm run optimize-json"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "preact": "^10.29.8",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "workbox-cli": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.1"
  }
}
